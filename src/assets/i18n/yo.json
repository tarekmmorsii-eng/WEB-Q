salẹ: -2px; osi: 15%; iwọn: 35%; iga: 2px; abẹlẹ-awọ: #22c55e; radius-aala: 2px 0 0 2px;\"></div>\n                 <div style=\"ipo: absolute; isalẹ: -2px; ọtun: 15%; iwọn: 35%; iga: 2px; awọ-ẹhin: #ef4444; rediosi-aala: 0 2px 2px 0;\"></div>\n            </div>\n        </div>\n    </div>\n    \n    <div style=\"ifihan: flex; Flex-wrap: wrap; aafo: 8px; font-iwọn: 0.75em; awọ: # 94a3b8; ila-giga: 1.3; ala-oke: 4px; oke-aala: 1px ri to rgba (255,255; 1255) aarin;\">\n        <span><span style=\"color: #22c55e;\">● </span> Surah Kanna</span>\n        <span><span style=\"color: #ef4444;\">● </span> Awọn Surah miiran</span>\n        <span><span style=\"color: #fbbf24;\">● </span> Mejeeji</span>\n    </div>\n</div>",
