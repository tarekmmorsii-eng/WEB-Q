  "tourAyahNumberDesc": "Tẹ nọmba Ayah lati wọle si awọn ẹya ti ilọsiwaju:\n- Iwọn agbara iranti:\n  • Alailagbara\n  • Alabọde\n  • O dara\n- Fi bukumaaki kun fun ẹsẹ naa\n- Wo Mutashabihat pẹlu ẹsẹ naa",
  "tourAyahColorsDesc": "<div style=\"display: flex; flex-direction: column; aafo: 15px; margin-top: 10px;\">\n    <div style=\"font-size: 0.95em; color: #cbd5e1;\">Awọ nọmba Ayah yi pada da lori ipele akori ti o ṣeto:</div>\n    \n    <div style=\"display: flex; justify-content: space-round; align-items: center; background: rgba(255,255,255,0.05); padding: 15px; border-radius: 12px;\">\n        <!-- Alailagbara -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"fidth: 40px; height: 40px; border-radius: 50%; background: rgba(239, 68, 68, 0.2); border: 2px solid #ef4444; display: flex; align-items: center; justify-content: center; position: nasaba;\">\n                 <span style=\"color: #ef4444; font-size: 18px; font-weight: bold;\">🔴</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #ef4444;\">Ailagbara</span>\n        </div>\n        \n        <!-- Alabọde -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"fidth: 40px; height: 40px; border-radius: 50%; background: rgba(234, 179, 8, 0.2); border: 2px solid #eab308; display: flex; align-items: center; justify-content: center; position: nasaba;\">\n                 <span style=\"color: #eab308; font-size: 18px; font-weight: bold;\">🟡</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #eab308;\">Alabọde</span>\n        </div>\n\n        <!-- O dara -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"fidth: 40px; height: 40px; border-radius: 50%; background: rgba(34, 197, 94, 0.2); border: 2px solid #22c55e; display: flex; align-items: center; justify-content: center; position: ojulumo;\">\n                 <span style=\"color: #22c55e; font-size: 18px; font-weight: bold;\"></span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #22c55e;\">O dara</span>\n        </div>\n    </div>\n</div>",
