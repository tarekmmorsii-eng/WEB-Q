    "tourMutashabihatDesc": "<div शैली = \"प्रदर्शन: फ्लेक्स; फ्लेक्स-दिशा: कॉलम; गैप: 8px; मार्जिन-टॉप: 5px;\">\n    <div style=\"font-size: 0.85em; color: #cbd5e1;\">मुताशाबिहात को इंगित करने के लिए अयाह संख्या के नीचे एक रंगीन रेखा दिखाई देती है:</div>\n    \n    <div शैली = \"प्रदर्शन: फ्लेक्स; औचित्य-सामग्री: अंतरिक्ष-चारों ओर; संरेखित-आइटम: फ्लेक्स-स्टार्ट; पृष्ठभूमि: आरजीबीए (255,255,255,0.05); पैडिंग: 8px; सीमा-त्रिज्या: 8px;\">\n        <!-- अंदर -->\n        <div शैली = \"प्रदर्शन: फ्लेक्स; फ्लेक्स-दिशा: कॉलम; संरेखित-आइटम: केंद्र; अंतर: 4px; चौड़ाई: 33%;\">\n            <div शैली = \"चौड़ाई: 26px; ऊंचाई: 26px; प्रदर्शन: फ्लेक्स; संरेखित-आइटम: केंद्र; औचित्य-सामग्री: केंद्र; स्थिति: सापेक्ष; सीमा-त्रिज्या: 50%; सीमा: 1px ठोस #fbbf24;\">\n                 <span style='font-size: 12px; फ़ॉन्ट-वजन: बोल्ड; रंग: #fbbf24;'>🟡</span>\n                 <div शैली = \"स्थिति: पूर्ण; निचला: -2px; बाएँ: 15%; दाएँ: 15%; ऊँचाई: 2px; पृष्ठभूमि-रंग: #22c55e; सीमा-त्रिज्या: 2px;\"></div>\n            </div>\n        </div>\n        \n        <!-- बाहर -->\n        <div शैली = \"प्रदर्शन: फ्लेक्स; फ्लेक���स-दिशा: कॉलम; संरेखित-आइटम: केंद्र; अंतर: 4px; चौड़ाई: 33%;\">\n            <div शैली = \"चौड़ाई: 26px; ऊंचाई: 26px; प्रदर्शन: फ्लेक्स; संरेखित-आइटम: केंद्र; औचित्य-सामग्री: केंद्र; स्थिति: सापेक्ष; सीमा-त्रिज्या: 50%; सीमा: 1px ठोस #fbbf24;\">\n                 <span style='font-size: 12px; फ़ॉन्ट-वजन: बोल्ड; रंग: #fbbf24;'>🟢</span>\n                 <div शैली = \"स्थिति: पू���्ण; निचला: -2px; बाएँ: 15%; दाएँ: 15%; ऊँचाई: 2px; पृष्ठभूमि-रंग: #ef4444; सीमा-त्रिज्या: 2px;\"></div>\n            </div>\n        </div>\n\n        <!-- दोनों -->\n        <div शैली = \"प्रदर्शन: फ्लेक्स; फ्लेक्स-दिशा: कॉलम; संरेखित-आइटम: केंद्र; अंतर: 4px; चौड़ाई: 33%;\">\n            <div शैली = \"चौड़ाई: 26px; ऊंचाई: 26px; प्रदर्शन: फ्लेक्स; संरेखित-आइटम: केंद्र; औचित्य-सामग्री: केंद्र; स्थिति: सापेक्ष; सीमा-त्रिज्या: 50%; सीमा: 1px ठोस #fbbf24;\">\n                 <span style='font-size: 12px; फ़ॉन्ट-वजन: बोल्ड; रंग: #fbbf24;'>🔴</span>\n                 <div शैली = \"स्थिति: पूर्ण; निचला: -2px; बाएँ: 15%; चौड़ाई: 35%; ऊँचाई: 2px; पृष्ठभूमि-रंग: #22c55e; सीमा-त्रिज्या: 2px 0 0 2px;\"></div>\n                 <div शैली = \"स्थिति: पूर्ण; निचला: -2px; दाएँ: 15%; चौड़ाई: 35%; ऊँचाई: 2px; पृष्ठभूमि-रंग: #ef4444; सीमा-त्रिज्या: 0 2px 2px 0;\"></div>\n            </div>\n        </div>\n    </div>\n    \n    <div शैली = \"डिस्प्ले: फ्लेक्स; फ्लेक्स-रैप: रैप; गैप: 8px; फॉन्ट-साइज: 0.75em; रंग: #94a3b8; लाइन-ऊंचाई: 1.3; मार्जिन-टॉप: 4px; बॉर्डर-टॉप: 1px सॉलिड आरजीबीए(255,255,255,0.1); पैडिंग-टॉप: 6px; जस्टिफाई-कंटेंट: सेंटर;\">\n        <span><span style=\"color: #22c55e;\">● </span> वही सूरह</span>\n        <span><span style=\"color: #ef4444;\">● </span> अन्य सूरह</span>\n        <span><span style=\"color: #fbbf24;\">● </span> दोनों</span>\n    </div>\n</div>",
