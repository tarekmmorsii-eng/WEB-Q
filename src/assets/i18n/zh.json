  "tourAyahNumberTitle": "阿亚号",
  "tourWeak": "虚弱的",
  "tourAyahColorsTitle": "记忆等级颜色",
  "tourAyahNumberDesc": "单击 Ayah 号码可访问高级功能：\n- 记忆强度等级：\n  • 弱\n  • 中等\n  • 好\n- 为该诗句添加书签\n- 查看 Mutashabihat 与诗句",
  "tourAyahColorsDesc": "<div style=\"显示：flex；flex-direction：列；间隙：15px；边距顶部：10px；\">\n    <div style=\"font-size: 0.95em; color: #cbd5e1;\">Ayah 数字的颜色根据您设置的记忆级别而变化：</div>\n    \n    <div style=\"display: flex; justify-content: space-around;align-items: center; background: rgba(255,255,255,0.05); padding: 15px; border-radius: 12px;\">\n        <!-- 弱 -->\n        <div style=\"显示：flex；flex-direction：列；align-items：中心；间隙：8px；\">\n            <div style=\"宽度: 40px; 高度: 40px; 边框半径: 50%; 背景: rgba(239, 68, 68, 0.2); 边框: 2px 实心 #ef4444; 显示: flex; 对齐项目: 中心; justify-content: 中心; 位置: 相对;\">\n                 <span style=\"color: #ef4444; font-size: 18px; font-weight: bold;\">🔴</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #ef4444;\">弱</span>\n        </div>\n        \n        <!-- 中 -->\n        <div style=\"显示：flex；flex-direction：列；align-items：中心；间隙：8px；\">\n            <div style=\"宽度: 40px; 高度: 40px; 边框半径: 50%; 背景: rgba(234, 179, 8, 0.2); 边框: 2px 实心 #eab308; 显示: flex; 对齐项目: 中心; justify-content: 中心; 位置: 相对;\">\n                 <span style=\"color: #eab308; font-size: 18px; font-weight: bold;\">🟡</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #eab308;\">中</span>\n        </div>\n\n        <!-- 好 -->\n        <div style=\"显示：flex；flex-direction：列；align-items：中心；间隙：8px；\">\n            <div style=\"宽度：40px；高度：40px；边框半径：50%；背景：rgba(34, 197, 94, 0.2)；边框：2px 实心 #22c55e；显示：flex；对齐项目：中心；对齐内容：中心；位置：相对；\">\n                 <span style=\"color：#22c55e；font-size：18px；font-weight：bold；\">🟢</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #22c55e;\">好</span>\n        </div>\n    </div>\n</div>",
  "tourMedium": "中等的",
  "tourGood": "好的",
  "tourSameSurah": "相同的古兰经",
  "tourMutashabihatTitle": "穆塔沙比哈特警报",
  "tourMutashabihatDesc": "<div style=\"显示：flex；flex-direction：列；间隙：8px；边距顶部：5px；\">\n    <div style=\"font-size: 0.85em; color: #cbd5e1;\">Ayah 数字下方会出现一条彩色线，表示 Mutashabihat：</div>\n    \n    <div style=\"display: flex; justify-content: space-around;align-items: flex-start;background: rgba(255,255,255,0.05); padding: 8px; border-radius: 8px;\">\n        <!-- 里面 -->\n        <div style=\"显示：flex；flex-direction：列；align-items：中心；间隙：4px；宽度：33%；\">\n            <div style=\"宽度：26px；高度：26px；显示：flex；对齐项目：中心；对齐内容：中心；位置：相对；边框半径：50%；边框：1px 实心#fbbf24；\">\n                 <span style=\"font-size: 12px; font-weight: 粗体; 颜色: #fbbf24;\">🟡</span>\n                 <div style=\"位置：绝对；底部：-2px；左：15%；右：15%；高度：2px；背景颜色：#22c55e；边框半径：2px；\"></div>\n            </div>\n        </div>\n        \n        <!-- 外面 -->\n        <div style=\"显示：flex；flex-direction：列；align-items：中心；间隙：4px；宽度：33%；\">\n            <div style=\"宽度：26px；高度：26px；显示：flex；对齐项目：中心；对齐内容：中心；位置：相对；边框半径：50%；边框：1px 实心#fbbf24；\">\n                 <span style=\"font-size: 12px; font-weight: 粗体; color: #fbbf24;\">🟢</span>\n                 <div style=\"位置：绝对；底部：-2px；左：15%；右：15%；高度：2px；背景颜色：#ef4444；边框半径：2px；\"></div>\n            </div>\n        </div>\n\n        <!-- 两者 -->\n        <div style=\"显示：flex；flex-direction：列；align-items：中心；间隙：4px；宽度：33%；\">\n            <div style=\"宽度：26px；高度：26px；显示：flex；对齐项目：中心；对齐内容：中心；位置：相对；边框半径：50%；边框：1px 实心#fbbf24；\">\n                 <span style=\"font-size: 12px; font-weight: 粗体; color: #fbbf24;\">🔴</span>\n                 <div style=\"位置：绝对；底部：-2px；左：15%；宽度：35%；高度：2px；背景颜色：#22c55e；边框半径：2px 0 0 2px；\"></div>\n                 <div style=\"位置：绝对；底部：-2px；右：15%；宽度：35%；高度：2px；背景颜色：#ef4444；边框半径：0 2px 2px 0;\"></div>\n            </div>\n        </div>\n    </div>\n    \n    <div style=\"显示：flex；flex-wrap：wrap；间隙：8px；字体大小：0.75em；颜色：#94a3b8；行高：1.3；顶部边距：4px；顶部边框：1px 实心rgba（255,255,255,0.1）；顶部填充：6px；对齐内容：中心；\">\n        <span><span style=\"color: #22c55e;\">● </span> 相同古兰经</span>\n        <span><span style=\"color: #ef4444;\">● </span> 其他古兰经</span>\n        <span><span style=\"color: #fbbf24;\">● </span> 两者</span>\n    </div>\n</div>",
