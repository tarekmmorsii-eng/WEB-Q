  "tourAyahColorsDesc": "<div style=\"display: flex; flex-direction: column; gap: 15px; margin-top: 10px;\">\n    <div style=\"font-size: 0.95em; color: #cbd5e1;\">El color del número del verso cambia según el nivel de memorización que establezca</div>\n    <div style=\"display: flex; justify-content: space-around; align-items: center; background: rgba(255,255,255,0.05); padding: 15px; border-radius: 12px;\">\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; height: 40px; border-radius: 50%; background: rgba(239, 68, 68, 0.2); border: 2px solid #ef4444; display: flex; align-items: center; justify-content: center;\"><span style=\"color: #ef4444; font-size: 18px;\">🔴</span></div>\n            <span style=\"font-size: 0.8em; color: #ef4444;\">Débil</span>\n        </div>\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; height: 40px; border-radius: 50%; background: rgba(234, 179, 8, 0.2); border: 2px solid #eab308; display: flex; align-items: center; justify-content: center;\"><span style=\"color: #eab308; font-size: 18px;\">🟡</span></div>\n            <span style=\"font-size: 0.8em; color: #eab308;\">Medio</span>\n        </div>\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; height: 40px; border-radius: 50%; background: rgba(34, 197, 94, 0.2); border: 2px solid #22c55e; display: flex; align-items: center; justify-content: center;\"><span style=\"color: #22c55e; font-size: 18px;\">🟢</span></div>\n            <span style=\"font-size: 0.8em; color: #22c55e;\">Bueno</span>\n        </div>\n    </div>\n</div>",
  "tourWeak": "Débil",
  "tourMedium": "Medio",
  "tourGood": "Bien",
  "tourMutashabihatTitle": "Alertas de Mutashabihat",
  "tourMutashabihatDesc": "<div style=\"display: flex; flex-direction: columna; espacio: 8px; margin-top: 5px;\">\n    <div style=\"font-size: 0.85em; color: #cbd5e1;\">Aparece una línea de color debajo del número Ayah para indicar Mutashabihat:</div>\n    \n    <div style=\"display: flex; justify-content: space-around; align-items: flex-start; fondo: rgba(255,255,255,0.05); padding: 8px; border-radius: 8px;\">\n        <!-- Dentro -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; espacio: 4px; ancho: 33%;\">\n            <div style=\"ancho: 26px; alto: 26px; visualización: flex; align-items: center; justify-content: center; posición: relativa; border-radius: 50%; border: 1px solid #fbbf24;\">\n                 <span style=\"font-size: 12px; font-weight: negrita; color: #fbbf24;\">🟡</span>\n                 <div style=\"posición: absoluta; abajo: -2px; izquierda: 15%; derecha: 15%; altura: 2px; color de fondo: #22c55e; radio de borde: 2px;\"></div>\n            </div>\n        </div>\n        \n        <!-- Afuera -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; espacio: 4px; ancho: 33%;\">\n            <div style=\"ancho: 26px; alto: 26px; visualización: flex; align-items: center; justify-content: center; posición: relativa; border-radius: 50%; border: 1px solid #fbbf24;\">\n                 <span style=\"font-size: 12px; font-weight: negrita; color: #fbbf24;\">🟢</span>\n                 <div style=\"posición: absoluta; abajo: -2px; izquierda: 15%; derecha: 15%; altura: 2px; color de fondo: #ef4444; radio de borde: 2px;\"></div>\n            </div>\n        </div>\n\n        <!-- Ambos -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; espacio: 4px; ancho: 33%;\">\n            <div style=\"ancho: 26px; alto: 26px; visualización: flex; align-items: center; justify-content: center; posición: relativa; border-radius: 50%; border: 1px solid #fbbf24;\">\n                 <span style=\"font-size: 12px; font-weight: negrita; color: #fbbf24;\">🔴</span>\n                 <div style=\"posición: absoluta; abajo: -2px; izquierda: 15%; ancho: 35%; altura: 2px; color de fondo: #22c55e; radio de borde: 2px 0 0 2px;\"></div>\n                 <div style=\"posición: absoluta; abajo: -2px; derecha: 15%; ancho: 35%; altura: 2px; color de fondo: #ef4444; radio de borde: 0 2px 2px 0;\"></div>\n            </div>\n        </div>\n    </div>\n    \n    <div style=\"display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.75em; color: #94a3b8; line-height: 1.3; margin-top: 4px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 6px; justify-content: center;\">\n        <span><span style=\"color: #22c55e;\">● </span> Misma sura</span>\n        <span><span style=\"color: #ef4444;\">● </span> Otras suras</span>\n        <span><span style=\"color: #fbbf24;\">● </span> Ambos</span>\n    </div>\n</div>",
