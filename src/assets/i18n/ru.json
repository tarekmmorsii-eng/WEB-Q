    "tourMutashabihatDesc": "<div style=\"display: flex; flex-direction: columns; зазор: 8 пикселей; поля сверху: 5 пикселей;\">\n    <div style=\"font-size: 0.85em; color: #cbd5e1;\">Под номером аята появляется цветная линия, обозначающая Муташабихат:</div>\n    \n    <div style=\"display: flex; justify-content: space-around; align-items: flex-start; background: rgba(255,255,255,0.05); отступ: 8 пикселей; border-radius: 8 пикселей;\">\n        <!-- Внутри -->\n        <div style=\"display: flex; flex-direction: columns; align-items: center; зазор: 4 пикселя; ширина: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; Position: относительный; border-radius: 50%; border: 1px Solid #fbbf24;\">\n                 <span style=\"font-size: 12px; шрифт-вес: жирный; цвет: #fbbf24;\">🟡</span>\n                 <div style=\"position: Absolute; снизу: -2px; слева: 15%; справа: 15%; высота: 2px; цвет фона: #22c55e; border-radius: 2px;\"></div>\n            </div>\n        </div>\n        \n        <!-- Снаружи -->\n        <div style=\"display: flex; flex-direction: columns; align-items: center; зазор: 4 пикселя; ширина: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; Position: относительный; border-radius: 50%; border: 1px Solid #fbbf24;\">\n                 <span style=\"font-size: 12px; шрифт-вес: жирный; цвет: #fbbf24;\">🟢</span>\n                 <div style=\"position: Absolute; снизу: -2px; слева: 15%; справа: 15%; высота: 2px; цвет фона: #ef4444; border-radius: 2px;\"></div>\n            </div>\n        </div>\n\n        <!-- Оба -->\n        <div style=\"display: flex; flex-direction: columns; align-items: center; зазор: 4 пикселя; ширина: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; Position: относительный; border-radius: 50%; border: 1px Solid #fbbf24;\">\n                 <span style=\"font-size: 12px; шрифт-вес: жирный; цвет: #fbbf24;\">🔴</span>\n                 <div style=\"position: Absolute; снизу: -2px; слева: 15%; ширина: 35%; высота: 2px; цвет фона: #22c55e; border-radius: 2px 0 0 2px;\"></div>\n                 <div style=\"position: Absolute; снизу: -2px; справа: 15%; ширина: 35%; высота: 2px; цвет фона: #ef4444; border-radius: 0 2px 2px 0;\"></div>\n            </div>\n        </div>\n    </div>\n    \n    <div style=\"display: flex; flex-wrap: Wrap; разрыв: 8 пикселей; размер шрифта: 0,75em; цвет: #94a3b8; line-height: 1,3; маржа-топ: 4 пикселя; граница-топ: 1 пиксель сплошной rgba(255,255,255,0,1); отступ-верх: 6 пикселей; justify-content: центр;\">\n        <span><span style=\"color: #22c55e;\">● </span> Та же сура</span>\n        <span><span style=\"color: #ef4444;\">● </span> Другие суры</span>\n        <span><span style=\"color: #fbbf24;\">● </span> И то, и другое</span>\n    </div>\n</div>",
