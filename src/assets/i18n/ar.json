    "tourMutashabihatDesc": "<div style=\"display: flex; flex-direction: column; gap: 8px; margin-top: 5px;\">\n    <div style=\"font-size: 0.85em; color: #cbd5e1;\">يظهر خط ملون أسفل رقم الآية للدلالة على المتشابهات:</div>\n    \n    <div style=\"display: flex; justify-content: space-around; align-items: flex-start; background: rgba(255,255,255,0.05); padding: 8px; border-radius: 8px;\">\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 4px; width: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; position: relative; border-radius: 50%; border: 1.5px solid #fbbf24;\">\n                 <span style=\"font-size: 14px; font-weight: bold; color: #cbd5e1;\">1</span>\n                 <div style=\"position: absolute; bottom: -2px; left: 15%; right: 15%; height: 2px; background-color: #22c55e; border-radius: 2px;\"></div>\n            </div>\n        </div>\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 4px; width: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; position: relative; border-radius: 50%; border: 1.5px solid #fbbf24;\">\n                 <span style=\"font-size: 14px; font-weight: bold; color: #cbd5e1;\">1</span>\n                 <div style=\"position: absolute; bottom: -2px; left: 15%; right: 15%; height: 2px; background-color: #ef4444; border-radius: 2px;\"></div>\n            </div>\n        </div>\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 4px; width: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; position: relative; border-radius: 50%; border: 1.5px solid #fbbf24;\">\n                 <span style=\"font-size: 14px; font-weight: bold; color: #cbd5e1;\">1</span>\n                 <div style=\"position: absolute; bottom: -2px; left: 15%; width: 35%; height: 2px; background-color: #22c55e; border-radius: 2px 0 0 2px;\"></div>\n                 <div style=\"position: absolute; bottom: -2px; right: 15%; width: 35%; height: 2px; background-color: #ef4444; border-radius: 0 2px 2px 0;\"></div>\n            </div>\n        </div>\n    </div>\n    \n    <div style=\"display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.75em; color: #94a3b8; line-height: 1.3; margin-top: 4px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 6px; justify-content: center; direction: rtl;\">\n        <div style=\"display: flex; align-items: center; gap: 4px;\">\n            <div style=\"width: 8px; height: 8px; border-radius: 50%; background: #22c55e;\"></div>\n            <span>نفس السورة</span>\n        </div>\n        <div style=\"display: flex; align-items: center; gap: 4px;\">\n            <div style=\"width: 8px; height: 8px; border-radius: 50%; background: #ef4444;\"></div>\n            <span>سور أخرى</span>\n        </div>\n        <div style=\"display: flex; align-items: center; gap: 4px;\">\n            <div style=\"width: 8px; height: 8px; border-radius: 50%; background: linear-gradient(to left, #22c55e 50%, #ef4444 50%);\"></div>\n            <span>كلاهما</span>\n        </div>\n    </div>\n</div>",
