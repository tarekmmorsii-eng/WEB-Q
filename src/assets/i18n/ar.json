    "tourAyahColorsDesc": "<div style=\"display: flex; flex-direction: column; gap: 15px; margin-top: 10px;\">\n    <div style=\"font-size: 0.95em; color: #cbd5e1; line-height: 1.4;\">يتغير لون رقم الآية بحسب مستوى الحفظ الذي تحدده لنفسك عند الضغط علي رقم الآيه</div>\n    \n    <div style=\"display: flex; justify-content: space-around; align-items: center; background: rgba(255,255,255,0.05); padding: 15px; border-radius: 12px;\">\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; height: 40px; border-radius: 50%; background: rgba(239, 68, 68, 0.2); border: 2.5px solid #ef4444; display: flex; align-items: center; justify-content: center;\">\n                 <span style=\"color: #ef4444; font-size: 18px; font-weight: bold;\">١</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #ef4444;\">ضعيف</span>\n        </div>\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; height: 40px; border-radius: 50%; background: rgba(234, 179, 8, 0.2); border: 2.5px solid #eab308; display: flex; align-items: center; justify-content: center;\">\n                 <span style=\"color: #eab308; font-size: 18px; font-weight: bold;\">٢</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #eab308;\">متوسط</span>\n        </div>\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; height: 40px; border-radius: 50%; background: rgba(34, 197, 94, 0.2); border: 2.5px solid #22c55e; display: flex; align-items: center; justify-content: center;\">\n                 <span style=\"color: #22c55e; font-size: 18px; font-weight: bold;\">٣</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #22c55e;\">جيد</span>\n        </div>\n    </div>\n</div>",
