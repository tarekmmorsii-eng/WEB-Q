  "tourAyahColorsDesc": "<div style=\"display: flex; flex-direction: Column; gap: 15px; margin-top: 10px;\">\n    <div style=\"font-size: 0.95em; color: #cbd5e1;\">Die Farbe der Ayah-Zahl ändert sich basierend auf der von Ihnen festgelegten Speicherstufe:</div>\n    \n    <div style=\"display: flex; justify-content: space-around; align-items: center; background: rgba(255,255,255,0.05); padding: 15px; border-radius: 12px;\">\n        <!-- Schwach -->\n        <div style=\"display: flex; flex-direction: columns; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; height: 40px; border-radius: 50%; background: rgba(239, 68, 68, 0.2); border: 2px solid #ef4444; display: flex; align-items: center; justify-content: center; position: relative;\">\n                 <span style=\"color: #ef4444; Schriftgröße: 18px; Schriftstärke: fett;\">🔴</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #ef4444;\">Schwach</span>\n        </div>\n        \n        <!-- Mittel -->\n        <div style=\"display: flex; flex-direction: columns; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; height: 40px; border-radius: 50%; background: rgba(234, 179, 8, 0.2); border: 2px solid #eab308; display: flex; align-items: center; justify-content: center; position: relative;\">\n                 <span style=\"color: #eab308; Schriftgröße: 18px; Schriftstärke: fett;\">🟡</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #eab308;\">Mittel</span>\n        </div>\n\n        <!-- Gut -->\n        <div style=\"display: flex; flex-direction: columns; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; height: 40px; border-radius: 50%; background: rgba(34, 197, 94, 0.2); border: 2px solid #22c55e; display: flex; align-items: center; justify-content: center; position: relative;\">\n                 <span style=\"color: #22c55e; Schriftgröße: 18px; Schriftstärke: fett;\">🟢</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #22c55e;\">Gut</span>\n        </div>\n    </div>\n</div>",
  "tourWeak": "Schwach",
  "tourMedium": "Medium",
  "tourGood": "Gut",
  "tourMutashabihatTitle": "Mutashabihat-Warnungen",
  "tourMutashabihatDesc": "<div style=\"display: flex; flex-direction: columns; gap: 8px; margin-top: 5px;\">\n    <div style=\"font-size: 0.85em; color: #cbd5e1;\">Eine farbige Linie erscheint unter der Ayah-Nummer, um Mutashabihat anzuzeigen:</div>\n    \n    <div style=\"display: flex; justify-content: space-around; align-items: flex-start; background: rgba(255,255,255,0.05); padding: 8px; border-radius: 8px;\">\n        <!-- Inside -->\n        <div style=\"display: flex; flex-direction: Column; align-items: center; gap: 4px; width: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; position: relative; border-radius: 50%; border: 1px solid #fbbf24;\">\n                 <span style=\"font-size: 12px; Schriftstärke: fett; Farbe: #fbbf24;\">🟡</span>\n                 <div style=\"position: absolute; unten: -2px; links: 15%; rechts: 15%; Höhe: 2px; Hintergrundfarbe: #22c55e; Randradius: 2px;\"></div>\n            </div>\n        </div>\n        \n        <!-- Draußen -->\n        <div style=\"display: flex; flex-direction: Column; align-items: center; gap: 4px; width: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; position: relative; border-radius: 50%; border: 1px solid #fbbf24;\">\n                 <span style=\"font-size: 12px; Schriftstärke: fett; Farbe: #fbbf24;\">🟢</span>\n                 <div style=\"position: absolute; unten: -2px; links: 15%; rechts: 15%; Höhe: 2px; Hintergrundfarbe: #ef4444; Randradius: 2px;\"></div>\n            </div>\n        </div>\n\n        <!-- Beide -->\n        <div style=\"display: flex; flex-direction: Column; align-items: center; gap: 4px; width: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; position: relative; border-radius: 50%; border: 1px solid #fbbf24;\">\n                 <span style=\"font-size: 12px; Schriftstärke: fett; Farbe: #fbbf24;\">🔴</span>\n                 <div style=\"position: absolute; unten: -2px; links: 15%; Breite: 35%; Höhe: 2px; Hintergrundfarbe: #22c55e; Randradius: 2px 0 0 2px;\"></div>\n                 <div style=\"position: absolute; unten: -2px; rechts: 15%; Breite: 35%; Höhe: 2px; Hintergrundfarbe: #ef4444; Randradius: 0 2px 2px 0;\"></div>\n            </div>\n        </div>\n    </div>\n    \n    <div style=\"display: flex; flex-wrap: wrap; Lücke: 8px; Schriftgröße: 0,75em; Farbe: #94a3b8; Zeilenhöhe: 1,3; Rand oben: 4px; Rand oben: 1px solid rgba(255,255,255,0.1); padding-top: 6px; justify-content: center;\">\n        <span><span style=\"color: #22c55e;\">● </span> Dieselbe Sure</span>\n        <span><span style=\"color: #ef4444;\">● </span> Andere Suren</span>\n        <span><span style=\"color: #fbbf24;\">● </span> Beides</span>\n    </div>\n</div>",
