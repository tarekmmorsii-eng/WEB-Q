  "tourMutashabihatTitle": "Mutashabihat ogohlantirishlari",
  "tourMutashabihatDesc": "<div style=\"display: flex; flex-direction: ustun; bo'shliq: 8px; margin-top: 5px;\">\n    <div style=\"font-size: 0.85em; color: #cbd5e1;\">Oyat raqami ostida Mutashabihatni bildirish uchun rangli chiziq paydo bo'ladi:</div>\n    \n    <div style=\"display: flex; justify-content: space-around; align-items: flex-start; fon: rgba(255,255,255,0.05); padding: 8px; border-radius: 8px;\">\n        <!-- Ichkarida -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; bo'shliq: 4px; eni: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; pozitsiya: nisbiy; chegara-radius: 50%; chegara: 1px qattiq #fbbf24;\">\n                 <span style=\"font-size: 12px; font-weight: bold; color: #fbbf24;\">🟡</span>\n                 <div style=\"position: mutlaq; pastki: -2px; chap: 15%; o'ng: 15%; balandlik: 2px; fon rangi: #22c55e; chegara radiusi: 2px;\"></div>\n            </div>\n        </div>\n        \n        <!-- Tashqarida -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; bo'shliq: 4px; eni: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; pozitsiya: nisbiy; chegara-radius: 50%; chegara: 1px qattiq #fbbf24;\">\n                 <span style=\"font-size: 12px; font-weight: bold; color: #fbbf24;\">🟢</span>\n                 <div style=\"position: mutlaq; pastki: -2px; chap: 15%; o'ng: 15%; balandlik: 2px; fon rangi: #ef4444; chegara radiusi: 2px;\"></div>\n            </div>\n        </div>\n\n        <!-- Ikkala -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; bo'shliq: 4px; eni: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; pozitsiya: nisbiy; chegara-radius: 50%; chegara: 1px qattiq #fbbf24;\">\n                 <span style=\"font-size: 12px; font-weight: bold; color: #fbbf24;\">🔴</span>\n                 <div style=\"position: mutlaq; pastki: -2px; chap: 15%; kenglik: 35%; balandlik: 2px; fon rangi: #22c55e; chegara radiusi: 2px 0 0 2px;\"></div>\n                 <div style=\"position: mutlaq; pastki: -2px; o'ng: 15%; kenglik: 35%; balandlik: 2px; fon rangi: #ef4444; chegara radiusi: 0 2px 2px 0;\"></div>\n            </div>\n        </div>\n    </div>\n    \n    <div style=\"display: flex; flex-wrap: wrap; boʻshliq: 8px; shrift oʻlchami: 0.75em; rang: #94a3b8; chiziq balandligi: 1.3; chet-usti: 4px; chegara tepasi: 1px qattiq rgba(255,255,255:1);-content6:-conting:0. markaz;\">\n        <span><span style=\"color: #22c55e;\">● </span> Xuddi shu sura</span>\n        <span><span style=\"color: #ef4444;\">● </span> Boshqa suralar</span>\n        <span><span style=\"color: #fbbf24;\">● </span> Ikkalasi</span>\n    </div>\n</div>",
