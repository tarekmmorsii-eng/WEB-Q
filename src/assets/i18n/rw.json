  "tourMutashabihatTitle": "Mutashabihat Alerts",
  "tourMutashabihatDesc": "<div style = \"kwerekana: flex; flex-icyerekezo: inkingi; icyuho: 8px; margin-hejuru: 5px;\">\n    <div style = \"Imyandikire-Ingano: 0,85em; ibara: # cbd5e1;\"> Umurongo wamabara ugaragara munsi yumubare wa Ayah kugirango werekane Mutashabihat: </div>\n    \n    <div style = \"kwerekana: flex; gutsindishiriza-ibirimo: umwanya-hafi; guhuza-ibintu: flex-gutangira; inyuma: rgba (255,255,255,0.05); padi: 8px; imipaka-radiyo: 8px;\">\n        <! - Imbere ->\n        <div style = \"kwerekana: flex; flex-icyerekezo: inkingi; guhuza-ibintu: hagati; icyuho: 4px; ubugari: 33%;\">\n            <div style = \"ubugari: 26px; uburebure: 26px; kwerekana: flex; guhuza-ibintu: hagati; kwemeza-ibirimo: hagati; umwanya: isano; imipaka-radiyo: 50%; umupaka: 1px ikomeye # fbbf24;\">\n                 <span style = \"Imyandikire-Ingano: 12px; Imyandikire-uburemere: itinyutse; ibara: # fbbf24;\"> 🟡 </span>\n                 <div style = \"umwanya: absolute; hepfo: -2px; ibumoso: 15%; iburyo: 15%; uburebure: 2px; ibara-ibara: # 22c55e; imipaka-radiyo: 2px;\"> </div>\n            </div>\n        </div>\n        \n        <! - Hanze ->\n        <div style = \"kwerekana: flex; flex-icyerekezo: inkingi; guhuza-ibintu: hagati; icyuho: 4px; ubugari: 33%;\">\n            <div style = \"ubugari: 26px; uburebure: 26px; kwerekana: flex; guhuza-ibintu: hagati; kwemeza-ibirimo: hagati; umwanya: isano; imipaka-radiyo: 50%; umupaka: 1px ikomeye # fbbf24;\">\n                 <span style = \"Imyandikire-Ingano: 12px; Imyandikire-uburemere: itinyutse; ibara: # fbbf24;\"> 🟢 </span>\n                 <div style = \"umwanya: absolute; hepfo: -2px; ibumoso: 15%; iburyo: 15%; uburebure: 2px; ibara-ibara: # ef4444; imipaka-radiyo: 2px;\"> </div>\n            </div>\n        </div>\n\n        <! - Byombi ->\n        <div style = \"kwerekana: flex; flex-icyerekezo: inkingi; guhuza-ibintu: hagati; icyuho: 4px; ubugari: 33%;\">\n            <div style = \"ubugari: 26px; uburebure: 26px; kwerekana: flex; guhuza-ibintu: hagati; kwemeza-ibirimo: hagati; umwanya: isano; imipaka-radiyo: 50%; umupaka: 1px ikomeye # fbbf24;\">\n                 <span style = \"Imyandikire-Ingano: 12px; Imyandikire-uburemere: itinyutse; ibara: # fbbf24;\"> 🔴 </span>\n                 <div style = \"umwanya: absolute; hepfo: -2px; ibumoso: 15%; ubugari: 35%; uburebure: 2px; ibara-ibara: # 22c55e; imipaka-radiyo: 2px 0 0 2px;\"> </div>\n                 <div style = \"umwanya: absolute; hepfo: -2px; iburyo: 15%; ubugari: 35%; uburebure: 2px; ibara-ibara: # ef4444; imipaka-radiyo: 0 2px 2px 0;\"> </div>\n            </div>\n        </div>\n    </div>\n    \n    <div style = \"kwerekana: flex; flex-gupfunyika: gupfunyika; icyuho: 8px; ingano-nini: 0,75em; ibara: # 94a3b8; umurongo-uburebure: 1.3; margin-top: 4px; umupaka-hejuru: 1px ikomeye rgba (255,255,255,0.1);\n        <span> <span style = \"ibara: # 22c55e;\"> ● </span> Sura imwe </span>\n        <span> <span style = \"ibara: # ef4444;\"> ● </span> Izindi Sura </span>\n        <span> <span style = \"ibara: # fbbf24;\"> ● </span> Byombi </span>\n    </div>\n</div>",
