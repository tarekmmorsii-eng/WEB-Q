    "tourShowAllTitle": "Show All",
    "tourShowAllDesc": "Click here to view the full page content and cancel any active hiding for verses or words.",
    "tourHideAllTitle": "Hide All",
    "tourHideAllDesc": "Click here to hide the entire page content, with flexible options to reveal when clicking on a verse for review:\n- Show verse up to its number\n- Show verse up to the nearest stop sign",
    "tourHideAyahsTitle": "Hide Verses",
    "tourHideAyahsDesc": "Click here to hide specific verses from the page according to several advanced criteria to test memorization:\n- Randomly hide verses\n- Hide rated verses:\n  • Weak memorization\n  • Medium memorization\n  • Good memorization\n- Hide verses not previously rated",
    "tourHideWordsTitle": "Hide Words",
    "tourHideWordsDesc": "Click here to control hiding specific words within the page to enhance focus:\n- Randomly hide words\n- Hide all words on the page",
    "tourFirstWordTitle": "First Word",
    "tourFirstWordDesc": "(Ayah Keys)\n\nControl the state of the (First Word) of each verse on the page to consolidate the beginnings of verses:\n- Hide the first word\n- Show the first word",
    "tourLastWordTitle": "Last Word",
    "tourLastWordDesc": "(Ayah Endings)\n\nControl the state of the (Last Word) of each verse on the page to adjust the endings of verses:\n- Hide the last word\n- Show the last word",
    "tourSurahNameTitle": "Surah Name",
    "tourSurahNameDesc": "Click on the Surah name to access advanced features:\n- Rate your memorization level for the entire Surah\n- Rate a group of verses in the Surah with the same rating at once",
    "tourAyahNumberTitle": "Ayah Number",
    "tourAyahNumberDesc": "Click on the Ayah number to access advanced features:\n- Memorization strength rating:\n  • Weak\n  • Medium\n  • Good\n- Add a bookmark for the verse\n- View Mutashabihat with the verse",
    "tourAyahColorsTitle": "Memorization Rating Colors",
    "tourAyahColorsDesc": "<div style=\"display: flex; flex-direction: column; gap: 15px; margin-top: 10px;\">\n    <div style=\"font-size: 0.95em; color: #cbd5e1;\">The color of the Ayah number changes based on the memorization level you set:</div>\n    \n    <div style=\"display: flex; justify-content: space-around; align-items: center; background: rgba(255,255,255,0.05); padding: 15px; border-radius: 12px;\">\n        <!-- Weak -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; height: 40px; border-radius: 50%; background: rgba(239, 68, 68, 0.2); border: 2px solid #ef4444; display: flex; align-items: center; justify-content: center; position: relative;\">\n                 <span style=\"color: #ef4444; font-size: 18px; font-weight: bold;\">🔴</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #ef4444;\">Weak</span>\n        </div>\n        \n        <!-- Medium -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; height: 40px; border-radius: 50%; background: rgba(234, 179, 8, 0.2); border: 2px solid #eab308; display: flex; align-items: center; justify-content: center; position: relative;\">\n                 <span style=\"color: #eab308; font-size: 18px; font-weight: bold;\">🟡</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #eab308;\">Medium</span>\n        </div>\n\n        <!-- Good -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; height: 40px; border-radius: 50%; background: rgba(34, 197, 94, 0.2); border: 2px solid #22c55e; display: flex; align-items: center; justify-content: center; position: relative;\">\n                 <span style=\"color: #22c55e; font-size: 18px; font-weight: bold;\">🟢</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #22c55e;\">Good</span>\n        </div>\n    </div>\n</div>",
    "tourWeak": "Weak",
    "tourMedium": "Medium",
    "tourGood": "Good",
    "tourMutashabihatTitle": "Mutashabihat Alerts",
    "tourMutashabihatDesc": "<div style=\"display: flex; flex-direction: column; gap: 8px; margin-top: 5px;\">\n    <div style=\"font-size: 0.85em; color: #cbd5e1;\">A colored line appears below the Ayah number to indicate Mutashabihat:</div>\n    \n    <div style=\"display: flex; justify-content: space-around; align-items: flex-start; background: rgba(255,255,255,0.05); padding: 8px; border-radius: 8px;\">\n        <!-- Inside -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 4px; width: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; position: relative; border-radius: 50%; border: 1px solid #fbbf24;\">\n                 <span style=\"font-size: 14px; font-weight: bold; color: #fbbf24;\">1</span>\n                 <div style=\"position: absolute; bottom: -2px; left: 15%; right: 15%; height: 2px; background-color: #22c55e; border-radius: 2px;\"></div>\n            </div>\n        </div>\n        \n        <!-- Outside -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 4px; width: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; position: relative; border-radius: 50%; border: 1px solid #fbbf24;\">\n                 <span style=\"font-size: 14px; font-weight: bold; color: #fbbf24;\">1</span>\n                 <div style=\"position: absolute; bottom: -2px; left: 15%; right: 15%; height: 2px; background-color: #ef4444; border-radius: 2px;\"></div>\n            </div>\n        </div>\n\n        <!-- Both -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 4px; width: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; position: relative; border-radius: 50%; border: 1px solid #fbbf24;\">\n                 <span style=\"font-size: 14px; font-weight: bold; color: #fbbf24;\">1</span>\n                 <div style=\"position: absolute; bottom: -2px; left: 15%; width: 35%; height: 2px; background-color: #22c55e; border-radius: 2px 0 0 2px;\"></div>\n                 <div style=\"position: absolute; bottom: -2px; right: 15%; width: 35%; height: 2px; background-color: #ef4444; border-radius: 0 2px 2px 0;\"></div>\n            </div>\n        </div>\n    </div>\n    \n    <div style=\"display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.75em; color: #94a3b8; line-height: 1.3; margin-top: 4px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 6px; justify-content: center;\">\n        <div style=\"display: flex; align-items: center; gap: 4px;\">\n            <div style=\"width: 8px; height: 8px; border-radius: 50%; background: #22c55e;\"></div>\n            <span>Same Surah</span>\n        </div>\n        <div style=\"display: flex; align-items: center; gap: 4px;\">\n            <div style=\"width: 8px; height: 8px; border-radius: 50%; background: #ef4444;\"></div>\n            <span>Other Surahs</span>\n        </div>\n        <div style=\"display: flex; align-items: center; gap: 4px;\">\n            <div style=\"width: 8px; height: 8px; border-radius: 50%; background: linear-gradient(to left, #22c55e 50%, #ef4444 50%);\"></div>\n            <span>Both</span>\n        </div>\n    </div>\n</div>",
