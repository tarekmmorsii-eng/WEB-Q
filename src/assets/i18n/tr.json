  "tourMutashabihatTitle": "Müteşabih Uyarıları",
  "tourMutashabihatDesc": "<div style=\"display: flex; flex-direction: column; gap: 8px; margin-top: 5px;\">\n    <div style=\"font-size: 0.85em; color: #cbd5e1;\">A colored line appears below the Ayah number to indicate Mutashabihat:</div>\n    \n    <div style=\"display: flex; justify-content: space-around; align-items: flex-start; arka plan: rgba(255,255,255,0,05); dolgu: 8px; border-radius: 8px;\">\n        <!-- İçeride -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 4px; width: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; konum: göreceli; border-radius: %50; border: 1px katı #fbbf24;\">\n                 <span style=\"font-size: 12px; font-weight: kalın; color: #fbbf24;\">🟡</span>\n                 <div style=\"position: absolute; bottom: -2px; left: 15%; right: 15%; height: 2px; background-color: #22c55e; border-radius: 2px;\"></div>\n            </div>\n        </div>\n        \n        <!-- Dışarıda -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 4px; width: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; konum: göreceli; border-radius: %50; border: 1px katı #fbbf24;\">\n                 <span style=\"font-size: 12px; font-weight: bold; color: #fbbf24;\">🟢</span>\n                 <div style=\"position: absolute; bottom: -2px; left: 15%; right: 15%; height: 2px; background-color: #ef4444; border-radius: 2px;\"></div>\n            </div>\n        </div>\n\n        <!-- İkisi de -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 4px; width: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; konum: göreceli; border-radius: %50; border: 1px katı #fbbf24;\">\n                 <span style=\"font-size: 12px; font-weight: bold; color: #fbbf24;\">🔴</span>\n                 <div style=\"konum: mutlak; alt: -2px; sol: %15; genişlik: %35; yükseklik: 2px; arka plan rengi: #22c55e; kenarlık yarıçapı: 2px 0 0 2px;\"></div>\n                 <div style=\"pozisyon: mutlak; alt: -2px; sağ: %15; genişlik: %35; yükseklik: 2px; arka plan rengi: #ef4444; kenarlık yarıçapı: 0 2px 2px 0;\"></div>\n            </div>\n        </div>\n    </div>\n    \n    <div style=\"display: flex; flex-wrap: sarma; boşluk: 8 piksel; yazı tipi boyutu: 0,75em; renk: #94a3b8; line-height: 1,3; marj-top: 4 piksel; border-top: 1px katı rgba(255,255,255,0,1); padding-top: 6px; justify-content: center;\">\n        <span><span style=\"color: #22c55e;\">● </span> Same Surah</span>\n        <span><span style=\"color: #ef4444;\">● </span> Other Surahs</span>\n        <span><span style=\"color: #fbbf24;\">● </span> Both</span>\n    </div>\n</div>",
