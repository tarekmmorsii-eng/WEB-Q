  "tourAyahColorsDesc": "<div style=\"display : flex ; flex-direction : colonne ; écart : 15 px ; margin-top : 10px ;\">\n    <div style=\"font-size: 0.95em; color: #cbd5e1;\">La couleur du numéro Ayah change en fonction du niveau de mémorisation que vous définissez :</div>\n    \n    <div style=\"display : flex ; justifier-content : espace-autour ; align-items : centre ; arrière-plan : rgba(255,255,255,0.05); remplissage : 15px ; border-radius : 12px ;\">\n        <!-- Faible -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"largeur : 40px ; hauteur : 40px ; border-radius : 50% ; background : rgba(239, 68, 68, 0.2) ; border : 2px solid #ef4444 ; display : flex ; align-items : center ; justifier-content : center ; position : relative ;\">\n                 <span style=\"color : #ef4444 ; taille de la police : 18 px ; poids de la police : gras ;\">🔴</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #ef4444;\">Faible</span>\n        </div>\n        \n        <!-- Moyen -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"largeur : 40px ; hauteur : 40px ; border-radius : 50 % ; background : rgba(234, 179, 8, 0.2); border : 2px solid #eab308 ; display : flex ; align-items : center ; justifier-content : center ; position : relative ;\">\n                 <span style=\"color : #eab308 ; taille de la police : 18 px ; poids de la police : gras ;\">🟡</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #eab308;\">Moyen</span>\n        </div>\n\n        <!-- Bien -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"largeur : 40px ; hauteur : 40px ; border-radius : 50% ; background : rgba(34, 197, 94, 0.2) ; border : 2px solid #22c55e ; display : flex ; align-items : center ; justifier-content : center ; position : relative ;\">\n                 <span style=\"color: #22c55e; taille de police: 18px; poids de police: gras;\">🟢</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #22c55e;\">Bon</span>\n        </div>\n    </div>\n</div>",
  "tourMedium": "Moyen",
  "tourGood": "Bien",
  "tourSameSurah": "Même sourate",
  "tourMutashabihatTitle": "Alertes Mutashabihat",
  "tourMutashabihatDesc": "<div style=\"affichage : flex ; flex-direction : colonne ; écart : 8 px ; marge supérieure : 5 px ;\">\n    <div style=\"font-size: 0.85em; color: #cbd5e1;\">Une ligne colorée apparaît sous le numéro Ayah pour indiquer Mutashabihat :</div>\n    \n    <div style=\"display : flex ; justifier-content : espace-autour ; align-items : flex-start ; arrière-plan : rgba(255,255,255,0.05); remplissage : 8px ; border-radius : 8px ;\">\n        <!-- À l'intérieur -->\n        <div style=\"display : flex ; flex-direction : colonne ; align-items : centre ; écart : 4 px ; largeur : 33 % ;\">\n            <div style=\"largeur : 26 px ; hauteur : 26 px ; affichage : flex ; align-items : centre ; justifier-contenu : centre ; position : relative ; rayon de bordure : 50 % ; bordure : 1px solide #fbbf24 ;\">\n                 <span style=\"font-size : 12px; font-weight : bold; color: #fbbf24;\">🟡</span>\n                 <div style=\"position : absolue ; bas : -2px ; gauche : 15 % ; droite : 15 % ; hauteur : 2px ; couleur d'arrière-plan : #22c55e ; rayon de bordure : 2px ;\"></div>\n            </div>\n        </div>\n        \n        <!-- Dehors -->\n        <div style=\"display : flex ; flex-direction : colonne ; align-items : centre ; écart : 4 px ; largeur : 33 % ;\">\n            <div style=\"largeur : 26 px ; hauteur : 26 px ; affichage : flex ; align-items : centre ; justifier-contenu : centre ; position : relative ; rayon de bordure : 50 % ; bordure : 1px solide #fbbf24 ;\">\n                 <span style=\"font-size : 12px ; font-weight : bold ; color : #fbbf24;\">🟢</span>\n                 <div style=\"position : absolue ; bas : -2px ; gauche : 15 % ; droite : 15 % ; hauteur : 2px ; couleur d'arrière-plan : #ef4444 ; rayon de bordure : 2px ;\"></div>\n            </div>\n        </div>\n\n        <!-- Les deux -->\n        <div style=\"display : flex ; flex-direction : colonne ; align-items : centre ; écart : 4 px ; largeur : 33 % ;\">\n            <div style=\"largeur : 26 px ; hauteur : 26 px ; affichage : flex ; align-items : centre ; justifier-contenu : centre ; position : relative ; rayon de bordure : 50 % ; bordure : 1px solide #fbbf24 ;\">\n                 <span style=\"font-size : 12px ; font-weight : gras ; couleur : #fbbf24;\">🔴</span>\n                 <div style=\"position : absolue ; bas : -2px ; gauche : 15 % ; largeur : 35 % ; hauteur : 2px ; couleur d'arrière-plan : #22c55e ; rayon de bordure : 2px 0 0 2px ;\"></div>\n                 <div style=\"position : absolue ; bas : -2px ; droite : 15 % ; largeur : 35 % ; hauteur : 2px ; couleur d'arrière-plan : #ef4444 ; rayon de bordure : 0 2px 2px 0;\"></div>\n            </div>\n        </div>\n    </div>\n    \n    <div style=\"affichage : flex ; flex-wrap : enveloppement ; écart : 8 px ; taille de la police : 0,75em ; couleur : #94a3b8 ; hauteur de ligne : 1,3 ; marge supérieure : 4 px ; bordure supérieure : 1 px solide rgba (255 255 255,0,1 ); rembourrage supérieur : 6 px ; justifier-contenu : centre ; \">\n        <span><span style=\"color: #22c55e;\">Quantity </span> Même sourate</span>\n        <span><span style=\"color: #ef4444;\">Quantity </span> Autres sourates</span>\n        <span><span style=\"color: #fbbf24;\">Quantity </span> Les deux</span>\n    </div>\n</div>",
