    "tourAyahColorsDesc": "<div style=\"display: flex; flex-direction: kolom; gap: 15px; margin-top: 10px;\">\n    <div style=\"font-size: 0.95em; color: #cbd5e1;\">Warna nomor Ayah berubah berdasarkan tingkat hafalan yang Anda atur:</div>\n    \n    <div style=\"display: flex; justify-content: space-around; align-items: center; latar belakang: rgba(255,255,255,0.05); padding: 15px; border-radius: 12px;\">\n        <!-- Lemah -->\n        <div style=\"display: flex; flex-direction: kolom; align-items: center; gap: 8px;\">\n            <div style=\"lebar: 40px; tinggi: 40px; radius batas: 50%; latar belakang: rgba(239, 68, 68, 0.2); batas: 2px solid #ef4444; tampilan: flex; align-items: center; justify-content: center; position: relative;\">\n                 <span style=\"color: #ef4444; ukuran font: 18 piksel; berat font: tebal;\">🔴</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #ef4444;\">Lemah</span>\n        </div>\n        \n        <!-- Sedang -->\n        <div style=\"display: flex; flex-direction: kolom; align-items: center; gap: 8px;\">\n            <div style=\"lebar: 40px; tinggi: 40px; radius batas: 50%; latar belakang: rgba(234, 179, 8, 0.2); batas: 2px solid #eab308; tampilan: flex; align-items: center; justify-content: center; position: relative;\">\n                 <span style=\"color: #eab308; ukuran font: 18 piksel; berat font: tebal;\">🟡</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #eab308;\">Sedang</span>\n        </div>\n\n        <!-- Bagus -->\n        <div style=\"display: flex; flex-direction: kolom; align-items: center; gap: 8px;\">\n            <div style=\"lebar: 40px; tinggi: 40px; radius batas: 50%; latar belakang: rgba(34, 197, 94, 0.2); batas: 2px solid #22c55e; tampilan: flex; align-items: center; justify-content: center; position: relative;\">\n                 <span style=\"color: #22c55e; ukuran font: 18 piksel; berat font: tebal;\">🟢</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #22c55e;\">Bagus</span>\n        </div>\n    </div>\n</div>",
    "tourMedium": "Sedang",
    "tourGood": "Bagus",
    "tourMutashabihatTitle": "Peringatan Mutashabihat",
    "tourSameSurah": "Surat yang sama",
    "tourMutashabihatDesc": "<div style=\"display: flex; flex-direction: kolom; gap: 8px; margin-top: 5px;\">\n    <div style=\"font-size: 0.85em; color: #cbd5e1;\">Garis berwarna muncul di bawah nomor Ayah untuk menunjukkan Mutashabihat:</div>\n    \n    <div style=\"display: flex; justify-content: space-around; align-items: flex-start; latar belakang: rgba(255,255,255,0.05); padding: 8px; border-radius: 8px;\">\n        <!-- Di dalam -->\n        <div style=\"display: flex; flex-direction: kolom; align-items: center; gap: 4px; lebar: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; position: relative; border-radius: 50%; border: 1px solid #fbbf24;\">\n                 <span style=\"ukuran font: 12 piksel; berat font: tebal; warna: #fbbf24;\">🟡</span>\n                 <div style=\"position: absolute; bawah: -2px; kiri: 15%; kanan: 15%; tinggi: 2px; warna latar: #22c55e; radius batas: 2px;\"></div>\n            </div>\n        </div>\n        \n        <!-- Di luar -->\n        <div style=\"display: flex; flex-direction: kolom; align-items: center; gap: 4px; lebar: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; position: relative; border-radius: 50%; border: 1px solid #fbbf24;\">\n                 <span style=\"font-size: 12px; font-weight: bold; color: #fbbf24;\">🟢</span>\n                 <div style=\"position: absolute; bawah: -2px; kiri: 15%; kanan: 15%; tinggi: 2px; warna latar: #ef4444; radius batas: 2px;\"></div>\n            </div>\n        </div>\n\n        <!-- Keduanya -->\n        <div style=\"display: flex; flex-direction: kolom; align-items: center; gap: 4px; lebar: 33%;\">\n            <div style=\"width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; position: relative; border-radius: 50%; border: 1px solid #fbbf24;\">\n                 <span style=\"font-size: 12px; font-weight: bold; color: #fbbf24;\">🔴</span>\n                 <div style=\"position: absolute; bawah: -2px; kiri: 15%; lebar: 35%; tinggi: 2px; warna latar: #22c55e; radius batas: 2px 0 0 2px;\"></div>\n                 <div style=\"position: absolute; bawah: -2px; kanan: 15%; lebar: 35%; tinggi: 2px; warna latar: #ef4444; radius batas: 0 2px 2px 0;\"></div>\n            </div>\n        </div>\n    </div>\n    \n    <div style=\"display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.75em; color: #94a3b8; line-height: 1.3; margin-top: 4px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 6px; justify-content: center;\">\n        <span><span style=\"color: #22c55e;\">● </span> Surat yang Sama</span>\n        <span><span style=\"color: #ef4444;\">● </span> Surat Lainnya</span>\n        <span><span style=\"color: #fbbf24;\">● </span> Keduanya</span>\n    </div>\n</div>",
