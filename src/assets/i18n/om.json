  "tourMutashabihatDesc": "<div style=\"agarsiisa: flex; flex-kallattii: tarjaa; qaawwa: 8px; margin-top: 5px;\">\n    <div style=\"font-size: 0.85em; color: #cbd5e1;\">Mutashabihat:</div> agarsiisuuf sararri halluu qabu lakkoofsa Ayyaa jalatti mul'ata\n    \n    <div style=\"agarsiisi: flex; qabiyyee-haqaa: iddoo-naannoo; wantoota-walsimsiisi: flex-jalqaba; duubbee: rgba(255,255,255,0.05); padding: 8px; daangaa-radius: 8px;\">\n        <!-- Keessa -->\n        <div style=\"agarsiisa: flex; flex-direction: tarjaa; qindeessuu-wantoota: giddugaleessa; qaawwa: 4px; bal'ina: 33%;\">\n            <div style=\"bal'inni: 26px; olka'iinsa: 26px; agarsiisa: flex; qindeessuu-wantoota: giddugaleessa; qabiyyee-haqeessuu: giddugaleessa; iddoo: fira; daangaa-raadiyaasii: 50%; daangaa: 1px jabaa #fbbf24;\">\n                 <span style=\"guddina qubee: 12px; ulfaatina qubee: jajjaboo; halluu: #fbbf24;\">🟡</span>\n                 <div style=\"bakka: guutuu; jala: -2px; bitaa: 15%; mirga: 15%; olka'iinsa: 2px; halluu-duuba: #22c55e; daangaa-radius: 2px;\"></div>\n            </div> jechuun ni danda’ama\n        </div> jechuun ni danda’ama\n        \n        <!-- Alaa -->\n        <div style=\"agarsiisa: flex; flex-direction: tarjaa; qindeessuu-wantoota: giddugaleessa; qaawwa: 4px; bal'ina: 33%;\">\n            <div style=\"bal'inni: 26px; olka'iinsa: 26px; agarsiisa: flex; qindeessuu-wantoota: giddugaleessa; qabiyyee-haqeessuu: giddugaleessa; iddoo: fira; daangaa-raadiyaasii: 50%; daangaa: 1px jabaa #fbbf24;\">\n                 <span style=\"guddina qubee: 12px; ulfaatina qubee: jajjaboo; halluu: #fbbf24;\">🟢</span>\n                 <div style=\"bakka: guutuu; jala: -2px; bitaa: 15%; mirga: 15%; olka'iinsa: 2px; halluu-duuba: #ef4444; daangaa-radius: 2px;\"></div>\n            </div> jechuun ni danda’ama\n        </div> jechuun ni danda’ama\n\n        <!-- Lamaanuu -->\n        <div style=\"agarsiisa: flex; flex-direction: tarjaa; qindeessuu-wantoota: giddugaleessa; qaawwa: 4px; bal'ina: 33%;\">\n            <div style=\"bal'inni: 26px; olka'iinsa: 26px; agarsiisa: flex; qindeessuu-wantoota: giddugaleessa; qabiyyee-haqeessuu: giddugaleessa; iddoo: fira; daangaa-raadiyaasii: 50%; daangaa: 1px jabaa #fbbf24;\">\n                 <span style=\"guddina qubee: 12px; ulfaatina qubee: jajjaboo; halluu: #fbbf24;\">🔴</span>\n                 <div style=\"bakka: absoluutii; jalaa: -2px; bitaa: 15%; bal'ina: 35%; olka'iinsa: 2px; halluu-duuba: #22c55e; daangaa-radius: 2px 0 0 2px;\"></div>\n                 <div style=\"bakka: guutuu; jala: -2px; mirga: 15%; bal'ina: 35%; olka'iinsa: 2px; halluu-duuba: #ef4444; daangaa-raadiyeesii: 0 2px 2px 0;\"></div>\n            </div> jechuun ni danda’ama\n        </div> jechuun ni danda’ama\n    </div> jechuun ni danda’ama\n    \n    <div style=\"agarsiisa: flex; flex-wrap: marfata; qaawwa: 8px; guddina-qubee: 0.75em; halluu: #94a3b8; sarara-olka'iinsa: 1.3; margin-gubbaa: 4px; daangaa-gubbaa: 1px jabaa rgba(255,255,255,0.1); padding-gubbaa: 6 px; justify-content: giddu galeessa;\">\n        <span><span style=\"color: #22c55e;\">● </span> Suuraa tokko</span>\n        <span><span style=\"color: #ef4444;\">● </span> Suuraalee biroo</span>\n        <span><span style=\"color: #fbbf24;\">● </span> Lamaanuu</span>\n    </div> jechuun ni danda’ama\n</div> jechuun ni danda’ama",
