  "tourAyahColorsDesc": "<div style=\"display: flex; flex-direction: column; gap: 15px; margin-top: 10px;\">\n    <div style=\"font-size: 0.95em; color: #cbd5e1;\">Launi na lambar ayah yana canzawa bisa matakin haddar da kuka saita:</div>\n    \n    <div style=\"display: flex; justify-content: space-around; align-items: center; background: rgba(255,255,255,0.05); padding: 15px; border-radius: 12px;\">\n        <!-- Rauni -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"nisa: 40px; tsawo: 40px; iyakar-radius: 50%; baya: rgba(239, 68, 68, 0.2); iyaka: 2px m #ef4444; nuni: flex; align-items: center; justify-content: center; position: dangi;\">\n                 <span style=\"color: #ef4444; font-size: 18px; font-weight: bold;\">🔴</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #ef4444;\">Rauni</span>\n        </div>\n        \n        <!-- Matsakaici -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"nisa: 40px; tsawo: 40px; iyakar-radius: 50%; baya: rgba(234, 179, 8, 0.2); iyaka: 2px m #eab308; nuni: flex; align-items: center; justify-content: center; position: dangi;\">\n                 <span style=\"color: #eab308; font-size: 18px; font-weight: bold;\">🟡</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #eab308;\">Matsakaici</span>\n        </div>\n\n        <!-- Na gode -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"nisa: 40px; tsawo: 40px; iyakar-radius: 50%; baya: rgba(34, 197, 94, 0.2); iyaka: 2px m # 22c55e; nuni: flex; daidaita abubuwa: cibiyar; justify-content: center; matsayi: dangi;\n                 <span style=\"color: #22c55e; font-size: 18px; font-weight: bold;\"></span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #22c55e;\">Mai kyau </span>\n        </div>\n    </div>\n</div>",
  "tourWeak": "Mai rauni",
  "tourMedium": "Matsakaici",
  "tourGood": "Yayi kyau",
  "tourMutashabihatTitle": "Mutashabihat Alerts",
  "tourMutashabihatDesc": "<div style=\"display: flex; flex-direction: column; gap: 8px; margin-top: 5px;\">\n    <div style=\"font-size: 0.85em; color: #cbd5e1;\">Layi mai launi ya bayyana a kasa lambar Ayah don nuna Mutashabihat:</div>\n    \n    <div style=\"display: flex; justify-content: space-around; align-items: flex-start; background: rgba(255,255,255,0.05); padding: 8px; border-radius: 8px;\">\n        <!-- Ciki -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 4px; width: 33%;\">\n            <div style=\"nisa: 26px; tsawo: 26px; nuni: flex; align-items: center; justify-content: center; matsayi: dangi; iyaka-radius: 50%; iyaka: 1px m #fbbf24;\">\n                 <span style=\"font-size: 12px; font-weight: bold; color: #fbbf24;\">🟡</span>\n                 <div style=\"ma matsayi: cikakkar; kasa: -2px; hagu: 15%; dama: 15%; tsawo: 2px; bango-launi: #22c55e; iyakar-radius: 2px;\"></div>\n            </div>\n        </div>\n        \n        <!-- Waje -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 4px; width: 33%;\">\n            <div style=\"nisa: 26px; tsawo: 26px; nuni: flex; align-items: center; justify-content: center; matsayi: dangi; iyaka-radius: 50%; iyaka: 1px m #fbbf24;\">\n                 <span style=\"font-size: 12px; font-weight: bold; color: #fbbf24;\"></span>\n                 <div style=\"ma matsayi: cikakken; kasa: -2px; hagu: 15%; dama: 15%; tsawo: 2px; bango-launi: #ef4444; iyakar-radius: 2px;\"></div>\n            </div>\n        </div>\n\n        <!-- Duk -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 4px; width: 33%;\">\n            <div style=\"nisa: 26px; tsawo: 26px; nuni: flex; align-items: center; justify-content: center; matsayi: dangi; iyaka-radius: 50%; iyaka: 1px m #fbbf24;\">\n                 <span style=\"font-size: 12px; font-weight: bold; color: #fbbf24;\">🔴</span>\n                 <div style=\"matsayi: cikakken; kasa: -2px; hagu: 15%; nisa: 35%; tsawo: 2px; bango-launi: #22c55e; iyakar-radius: 2px 0 0 2px;\"> </div>\n                 <div style=\"ma matsayi: cikakkar; kasa: -2px; dama: 15%; nisa: 35%; tsawo: 2px; bango-launi: #ef4444; iyakar-radius: 0 2px 2px 0;\"> </div>\n            </div>\n        </div>\n    </div>\n    \n    <div style=\"nuni: flex; flex-wrap: wrap; rata: 8px; girman girman font: 0.75em; launi: #94a3b8; layin-tsawo: 1.3; gefe-saman: 4px; iyakar-saman: 1px m rgba (255,255; 1255; 655,255; 255; pxtop: 255, 255; 1255: 655, 0.555, 0.555, 0.555, 0.555, 0.555, 0.0) tsakiya;\">\n        <span><span style=\"color: #22c55e;\">● </span> Surah guda daya</span>\n        <span><span style=\"color: #ef4444;\">● </span> Sauran surorin</span>\n        <span><span style=\"color: #fbbf24;\">● </span> Duka</span>\n    </div>\n</div>",
