    "tourAyahColorsDesc": "<div style=\"display: flex; flex-direction: column; gap: 15px; margin-top: 10px;\">\n    <div style=\"font-size: 0.95em; color: #cbd5e1;\">Launi na lambar ayah yana canzawa bisa matakin haddar da kuka saita:</div>\n    \n    <div style=\"display: flex; justify-content: space-around; align-items: center; background: rgba(255,255,255,0.05); padding: 15px; border-radius: 12px;\">\n        <!-- Rauni -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"nisa: 40px; tsawo: 40px; iyakar-radius: 50%; baya: rgba(239, 68, 68, 0.2); iyaka: 2px m #ef4444; nuni: flex; align-items: center; justify-content: center; position: dangi;\">\n                 <span style=\"color: #ef4444; font-size: 18px; font-weight: bold;\">🔴</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #ef4444;\">Rauni</span>\n        </div>\n        \n        <!-- Matsakaici -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"nisa: 40px; tsawo: 40px; iyakar-radius: 50%; baya: rgba(234, 179, 8, 0.2); iyaka: 2px m #eab308; nuni: flex; align-items: center; justify-content: center; position: dangi;\">\n                 <span style=\"color: #eab308; font-size: 18px; font-weight: bold;\">🟡</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #eab308;\">Matsakaici</span>\n        </div>\n\n        <!-- Na gode -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"nisa: 40px; tsawo: 40px; iyakar-radius: 50%; baya: rgba(34, 197, 94, 0.2); iyaka: 2px m # 22c55e; nuni: flex; daidaita abubuwa: cibiyar; justify-content: center; matsayi: dangi;\n                 <span style=\"color: #22c55e; font-size: 18px; font-weight: bold;\"></span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #22c55e;\">Mai kyau </span>\n        </div>\n    </div>\n</div>",
