  "tourAyahColorsTitle": "මතක තබා ගැනීමේ ශ්‍රේණිගත කිරීමේ වර්ණ",
  "tourAyahColorsDesc": "<div style=\"display: flex; flex-direction: column; gap: 15px; margin-top: 10px;\">\n    <div style=\"font-size: 0.95em; color: #cbd5e1;\">ඔබ විසින් සකසා ඇති කටපාඩම් මට්ටම මත පදනම්ව Ayah අංකයේ වර්ණය වෙනස් වේ:</div>\n    \n    <div style=\"display: flex; justify-content: space-around; align-items: center; background: rgba(255,255,255,0.05); padding: 15px; border-radius: 12px;\">\n        <!-- දුර්වල -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; උස: 40px; border-radius: 50%; background: rgba(239, 68, 68, 0.2); border: 2px solid #ef4444; display: flex; align-items: center; justify-content;\"> මධ්‍යස්ථානය;\n                 <span style=\"color: #ef4444; font-size: 18px; font-weight: bold;\">🔴</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #ef4444;\">දුර්වල</span>\n        </div>\n        \n        <!-- මධ්‍යම -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; උස: 40px; border-radius: 50%; background: rgba(234, 179, 8, 0.2); border: 2px solid #eab308; display: flex; align-items: center; justify-content;\"> මධ්‍යස්ථානය;\n                 <span style=\"color: #eab308; font-size: 18px; font-weight: bold;\">🟡</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #eab308;\">මධ්‍යම</span>\n        </div>\n\n        <!-- හොඳයි -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; height: 40px; border-radius: 50%; background: rgba(34, 197, 94, 0.2); border: 2px solid #22c55e; display: flex; align-items: center; justify-content;> center;\n                 <span style=\"color: #22c55e; font-size: 18px; font-weight: bold;\">🟢</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #22c55e;\">හොඳයි</span>\n        </div>\n    </div>\n</div>",
  "tourWeak": "දුර්වලයි",
  "tourMedium": "මධ්යම",
  "tourGood": "හොඳයි",
