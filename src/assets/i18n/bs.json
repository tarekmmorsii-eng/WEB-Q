  "tourMutashabihatTitle": "Mutashabihat Alerts",
  "tourMutashabihatDesc": "<div style=\"display: flex; flex-direction: column; gap: 8px; margin-top: 5px;\">\n    <div style=\"font-size: 0.85em; color: #cbd5e1;\">Obojena linija se pojavljuje ispod broja ajeta koja označava Mutashabihat:</div>\n    \n    <div style=\"display: flex; justify-content: space-around; align-items: flex-start; background: rgba(255,255,255,0.05); padding: 8px; border-radius: 8px;\">\n        <!-- Unutra -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 4px; width: 33%;\">\n            <div style=\"width: 26px; visina: 26px; display: flex; align-items: center; justify-content: center; position: relative; border-radius: 50%; border: 1px solid #fbbf24;\">\n                 <span style=\"font-size: 12px; font-weight: bold; color: #fbbf24;\">🟡</span>\n                 <div style=\"position: absolute; bottom: -2px; lijevo: 15%; desno: 15%; visina: 2px; background-color: #22c55e; border-radius: 2px;\"></div>\n            </div>\n        </div>\n        \n        <!-- Napolju -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 4px; width: 33%;\">\n            <div style=\"width: 26px; visina: 26px; display: flex; align-items: center; justify-content: center; position: relative; border-radius: 50%; border: 1px solid #fbbf24;\">\n                 <span style=\"font-size: 12px; font-weight: bold; color: #fbbf24;\">🟢</span>\n                 <div style=\"position: absolute; bottom: -2px; lijevo: 15%; desno: 15%; visina: 2px; background-color: #ef4444; border-radius: 2px;\"></div>\n            </div>\n        </div>\n\n        <!-- Oba -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 4px; width: 33%;\">\n            <div style=\"width: 26px; visina: 26px; display: flex; align-items: center; justify-content: center; position: relative; border-radius: 50%; border: 1px solid #fbbf24;\">\n                 <span style=\"font-size: 12px; font-weight: bold; color: #fbbf24;\">🔴</span>\n                 <div style=\"position: absolute; bottom: -2px; lijevo: 15%; širina: 35%; visina: 2px; background-color: #22c55e; border-radius: 2px 0 0 2px;\"></div>\n                 <div style=\"position: absolute; bottom: -2px; desno: 15%; širina: 35%; visina: 2px; background-color: #ef4444; border-radius: 0 2px 2px 0;\"></div>\n            </div>\n        </div>\n    </div>\n    \n    <div style=\"display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.75em; color: #94a3b8; line-height: 1.3; margin-top: 4px; border-top: 1px solid rgba(255,255,255,0.1;content:content-topify;control:content:control:content:content:content:\n        <span><span style=\"color: #22c55e;\">● </span> Ista sura</span>\n        <span><span style=\"color: #ef4444;\">● </span> Ostale sure</span>\n        <span><span style=\"color: #fbbf24;\">● </span> Oba</span>\n    </div>\n</div>",
