  "tourWeak": "ደካማ",
  "tourAyahColorsTitle": "የማስታወስ ደረጃ አሰጣጥ ቀለሞች",
  "tourAyahNumberDesc": "የላቁ ባህሪያትን ለማግኘት በአያህ ቁጥር ላይ ጠቅ ያድርጉ፡\n- የማስታወስ ጥንካሬ ደረጃ;\n  • ደካማ\n  • መካከለኛ\n  • ጥሩ\n- ለቁጥሩ ዕልባት ጨምር\n- ሙተሻቢያትን ከጥቅሱ ጋር ይመልከቱ",
  "tourAyahColorsDesc": "<div style=\"display: flex; flex-direction: column; gap: 15px; margin-top: 10px;\">\n    <div style=\"font-size: 0.95em; color: #cbd5e1;\">የያህ ቁጥር ቀለም እርስዎ ባዘጋጁት የማስታወስ ደረጃ ላይ በመመስረት ይቀየራል፡</div>\n    \n    <div style=\"display: flex; justify-content: space-round; align-items: center; background: rgba(255,255,255,0.05); padding: 15px; border-radius: 12px;\">\n        <!-- ደካማ -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; height: 40px; border-radius: 50%; background: rgba(239, 68, 68, 0.2); border: 2px solid #ef4444; display: flex; align-items: center; justify-content: center; position: አንጻራዊ;\">\n                 <span style=\"color: #ef4444; font-size: 18px; font-weight: bold;\">🔴</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #ef4444;\">ደካማ</span>\n        </div>\n        \n        <!-- መካከለኛ -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; height: 40px; border-radius: 50%; background: rgba(234, 179, 8, 0.2); border: 2px solid #eab308; display: flex; align-items: center; justify-content: center; position: አንጻራዊ;\">\n                 <span style=\"color: #eab308; font-size: 18px; font-weight: bold;\">🟡</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #eab308;\">መካከለኛ</span>\n        </div>\n\n        <!-- ጥሩ -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; height: 40px; border-radius: 50%; background: rgba(34, 197, 94, 0.2); border: 2px solid #22c55e; display: flex; align-items: center; justify-content: center; position: አንጻራዊ;\">\n                 <span style=\"color: #22c55e; font-size: 18px; font-weight: bold;\"></span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #22c55e;\">ጥሩ</span>\