  "tourShowAllTitle": "ሁሉንም አሳይ",
  "tourShowAllDesc": "የሙሉ ገጽ ይዘትን ለማየት እና ለቁጥር ወይም ለቃላት መደበቅን ለመሰረዝ እዚህ ጠቅ ያድርጉ።",
  "tourHideAllTitle": "ሁሉንም ደብቅ",
  "tourHideAllDesc": "ሙሉውን የገጽ ይዘት ለመደበቅ እዚህ ጠቅ ያድርጉ፣ ለግምገማ ጥቅስ ላይ ጠቅ ሲያደርጉ ከሚገለጡ ተለዋዋጭ አማራጮች ጋር፡\n- ጥቅሱን እስከ ቁጥሩ አሳይ\n- ቁጥር እስከ ቅርብ የማቆሚያ ምልክት አሳይ",
  "tourHideAyahsTitle": "ጥቅሶችን ደብቅ",
  "tourHideAyahsDesc": "የማስታወስ ችሎታን ለመፈተሽ በበርካታ የላቁ መስፈርቶች መሰረት የተወሰኑ ጥቅሶችን ከገጹ ለመደበቅ እዚህ ጠቅ ያድርጉ፡\n- በዘፈቀደ ጥቅሶችን ደብቅ\n- ደረጃ የተሰጣቸውን ጥቅሶች ደብቅ፡-\n  • ደካማ የማስታወስ ችሎታ\n  • መካከለኛ ትውስታ\n  • ጥሩ የማስታወስ ችሎታ\n- ከዚህ ቀደም ደረጃ ያልተሰጣቸውን ጥቅሶች ደብቅ",
  "tourHideWordsTitle": "ቃላትን ደብቅ",
  "tourHideWordsDesc": "ትኩረትን ለማሻሻል በገጹ ውስጥ የተወሰኑ ቃላትን መደበቅ ለመቆጣጠር እዚህ ጠቅ ያድርጉ፡\n- በዘፈቀደ ቃላትን ደብቅ\n- ሁሉንም ቃላት በገጹ ላይ ደብቅ",
  "tourFirstWordTitle": "የመጀመሪያ ቃል",
  "tourFirstWordDesc": "(አያህ ቁልፎች)\n\nየጥቅሶቹን መጀመሪያ ለማጠናከር በገጹ ላይ ያለውን የእያንዳንዱን ቁጥር (የመጀመሪያ ቃል) ሁኔታ ይቆጣጠሩ፡-\n- የመጀመሪያውን ቃል ደብቅ\n- የመጀመሪያውን ቃል አሳይ",
  "tourLastWordTitle": "የመጨረሻ ቃል",
  "tourLastWordDesc": "(አያ መጨረሻ)\n\nየጥቅሶቹን መጨረሻ ለማስተካከል በገጹ ላይ ያለውን የእያንዳንዱን ቁጥር (የመጨረሻ ቃል) ሁኔታ ይቆጣጠሩ፡-\n- የመጨረሻውን ቃል ደብቅ\n- የመጨረሻውን ቃል አሳይ",
  "tourSurahNameTitle": "የሱራ ስም",
  "tourSurahNameDesc": "የላቁ ባህሪያትን ለማግኘት የሱራውን ስም ጠቅ ያድርጉ፡\n- ለመላው ሱራ የማስታወስ ደረጃህን ደረጃ ስጥ\n- በሱራ ውስጥ ያሉትን የጥቅሶች ቡድን በተመሳሳይ ደረጃ በአንድ ጊዜ ደረጃ ይስጡ",
  "tourAyahNumberTitle": "አያህ ቁጥር",
  "tourAyahNumberDesc": "የላቁ ባህሪያትን ለማግኘት በአያህ ቁጥር ላይ ጠቅ ያድርጉ፡\n- የማስታወስ ጥንካሬ ደረጃ;\n  • ደካማ\n  • መካከለኛ\n  • ጥሩ\n- ለቁጥሩ ዕልባት ጨምር\n- ሙተሻቢያትን ከጥቅሱ ጋር ይመልከቱ",
  "tourAyahColorsTitle": "የማስታወስ ደረጃ አሰጣጥ ቀለሞች",
  "tourAyahColorsDesc": "<div style=\"display: flex; flex-direction: column; gap: 15px; margin-top: 10px;\">\n    <div style=\"font-size: 0.95em; color: #cbd5e1;\">የያህ ቁጥር ቀለም እርስዎ ባዘጋጁት የማስታወስ ደረጃ ላይ በመመስረት ይቀየራል፡</div>\n    \n    <div style=\"display: flex; justify-content: space-round; align-items: center; background: rgba(255,255,255,0.05); padding: 15px; border-radius: 12px;\">\n        <!-- ደካማ -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; height: 40px; border-radius: 50%; background: rgba(239, 68, 68, 0.2); border: 2px solid #ef4444; display: flex; align-items: center; justify-content: center; position: አንጻራዊ;\">\n                 <span style=\"color: #ef4444; font-size: 18px; font-weight: bold;\">🔴</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #ef4444;\">ደካማ</span>\n        </div>\n        \n        <!-- መካከለኛ -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; height: 40px; border-radius: 50%; background: rgba(234, 179, 8, 0.2); border: 2px solid #eab308; display: flex; align-items: center; justify-content: center; position: አንጻራዊ;\">\n                 <span style=\"color: #eab308; font-size: 18px; font-weight: bold;\">🟡</span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #eab308;\">መካከለኛ</span>\n        </div>\n\n        <!-- ጥሩ -->\n        <div style=\"display: flex; flex-direction: column; align-items: center; gap: 8px;\">\n            <div style=\"width: 40px; height: 40px; border-radius: 50%; background: rgba(34, 197, 94, 0.2); border: 2px solid #22c55e; display: flex; align-items: center; justify-content: center; position: አንጻራዊ;\">\n                 <span style=\"color: #22c55e; font-size: 18px; font-weight: bold;\"></span>\n            </div>\n            <span style=\"font-size: 0.8em; color: #22c55e;\">ጥሩ</span>\n        </div>\n    </div>\n</div>",
