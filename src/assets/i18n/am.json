yle=\"position: absolute; bottom: -2px; left: 15%; width: 35%; height: 2px; background-color: #22c55e; border-radius: 2px 0 0 2px;\"></div>\n                 <div style=\"position: absolute; bottom: -2px; right: 15%; width: 35%; height: 2px; background-color: #ef4444; border-radius: 0 2px 2px 0;\"></div>\n            </div>\n        </div>\n    </div>\n    \n    <div style=\"display: flex; flex-wrap: wrap: gap: 8px; font-size: 0.75em; color: #94a3b8; line-high: 1.3;margin-top: 4px; border-top: 1px solid rgba (255,255,1255,ptent-top)፡-ገጽታ ብቻ መሃል;\">\n        <span><span style=\"color: #22c55e;\">● </span> ተመሳሳይ ሱራ</span>\n        <span><span style=\"color: #ef4444;\">● </span> ሌሎች ሱራዎች</span>\n        <span><span style=\"color: #fbbf24;\">● </span> ሁለቱም</span>\n    </div>\n</div>",
